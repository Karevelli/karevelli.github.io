source "https://rubygems.org"

# Match the GitHub Pages Jekyll version
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
    gem "jekyll-seo-tag"
    # Loaded by Bundler: the github-pages gem never loads the _plugins folder.
    gem "jekyll-build-cache", path: "_plugins/jekyll-build-cache"
end

gem "webrick", "~> 1.7"
